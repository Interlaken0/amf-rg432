{
  appId: 'com.jjconfederation.rg432-test-rig',
  productName: 'AMF RG432 Test Rig',
  publish: null,
  directories: {
    output: 'release',
  },
  files: [
    'dist',
  ],
  asarUnpack: [
    'node_modules/**/*.node',
  ],
  extraResources: [
    {
      from: 'dll',
      to: 'dll',
      filter: ['**/*.dll'],
    },
  ],
  win: {
    target: 'nsis',
  },
  nsis: {
    oneClick: false,
    allowToChangeInstallationDirectory: true,
  },
}
